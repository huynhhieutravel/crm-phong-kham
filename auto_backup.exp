#!/usr/bin/expect -f

set timeout -1
set password {&m5L9[eUv}

puts "1. Creating backup on VPS..."
spawn ssh -o StrictHostKeyChecking=no ubutu@112.78.15.2 "mysqldump -u crm_admin -p'CrmAdmin2026@Pass' clinic_management > /tmp/database.sql && echo '&m5L9\[eUv' | sudo -S tar -czf /tmp/vps_full_backup.tar.gz -C /var/www/crm_phong_kham . -C /tmp database.sql && echo '&m5L9\[eUv' | sudo -S chown ubutu:ubutu /tmp/vps_full_backup.tar.gz && rm /tmp/database.sql"

expect {
    "*assword:*" {
        send "$password\r"
        exp_continue
    }
    eof
}

puts "2. Downloading backup to local machine..."
spawn scp -o StrictHostKeyChecking=no ubutu@112.78.15.2:/tmp/vps_full_backup.tar.gz Backup/vps_full_backup.tar.gz
expect {
    "*assword:*" {
        send "$password\r"
        exp_continue
    }
    eof
}

puts "3. Cleaning up VPS..."
spawn ssh -o StrictHostKeyChecking=no ubutu@112.78.15.2 "rm /tmp/vps_full_backup.tar.gz"
expect {
    "*assword:*" {
        send "$password\r"
        exp_continue
    }
    eof
}

puts "Backup completed successfully!"
