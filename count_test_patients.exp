#!/usr/bin/expect -f
set timeout -1
set password {&m5L9[eUv}

spawn ssh -o StrictHostKeyChecking=no ubutu@112.78.15.2 "echo '&m5L9\[eUv' | sudo -S mysql -e \"USE clinic_management; SELECT COUNT(*) FROM patients WHERE full_name LIKE '%Test%';\""
expect {
    "*assword:*" {
        send "$password\r"
        exp_continue
    }
    eof
}
