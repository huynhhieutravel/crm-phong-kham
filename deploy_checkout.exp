#!/usr/bin/expect -f
set timeout -1
set password {&m5L9[eUv}

spawn scp -o StrictHostKeyChecking=no modules/sales/checkout.php ubutu@112.78.15.2:/tmp/
expect {
    "*assword:*" {
        send "$password\r"
        exp_continue
    }
    eof
}

spawn ssh -o StrictHostKeyChecking=no ubutu@112.78.15.2 "echo '&m5L9\[eUv' | sudo -S cp /tmp/checkout.php /var/www/crm_phong_kham/modules/sales/checkout.php && echo '&m5L9\[eUv' | sudo -S chown www-data:www-data /var/www/crm_phong_kham/modules/sales/checkout.php && rm /tmp/checkout.php"
expect {
    "*assword:*" {
        send "$password\r"
        exp_continue
    }
    eof
}
