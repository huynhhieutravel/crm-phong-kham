spawn ssh -o StrictHostKeyChecking=no ubutu@112.78.15.2 "echo '&m5L9\[eUv' | sudo -S mysql -e \"USE clinic_management; ALTER TABLE packages ADD COLUMN coin_cost DECIMAL(10,2) DEFAULT 2 AFTER total_price;\""
