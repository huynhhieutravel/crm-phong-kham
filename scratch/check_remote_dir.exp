#!/usr/bin/expect -f

set timeout 30
set ip "112.78.15.2"
set user "ubutu"
set pass "&m5L9\[eUv"

spawn ssh -o StrictHostKeyChecking=no $user@$ip

expect {
    "password:" {
        send "$pass\r"
    }
    timeout {
        puts "Timeout waiting for password prompt"
        exit 1
    }
}

expect {
    "$ " {
        send "find /var/www -maxdepth 2 -type d 2>/dev/null | grep -E 'crm|simon|phong-kham' || echo 'NOT_FOUND'\r"
    }
    "# " {
        send "find /var/www -maxdepth 2 -type d 2>/dev/null | grep -E 'crm|simon|phong-kham' || echo 'NOT_FOUND'\r"
    }
}

expect {
    "$ " {
        send "exit\r"
    }
    "# " {
        send "exit\r"
    }
}

expect eof
