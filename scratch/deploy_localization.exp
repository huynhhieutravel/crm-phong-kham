#!/usr/bin/expect -f

set timeout 300
set ip "112.78.15.2"
set user "ubutu"
set pass "&m5L9\[eUv"
set remote_dir "/var/www/crm_phong_kham"
set source_dir "/Volumes/T7 Loki SS/WORK Hiếu/quan-ly-phong-kham/"
set exclude_file "/Volumes/T7 Loki SS/WORK Hiếu/quan-ly-phong-kham/scratch/rsync_exclude.txt"

# 1. Open permissions on remote server
puts "Opening permissions on remote server..."
spawn ssh -t $user@$ip "sudo chmod -R 777 $remote_dir"
expect {
    "password for $user:" {
        send "$pass\r"
        exp_continue
    }
    "password:" {
        send "$pass\r"
        exp_continue
    }
    eof
}

# 2. Sync files
puts "Syncing files..."
spawn rsync -avzi --delete --exclude-from=$exclude_file -e "ssh -o StrictHostKeyChecking=no" $source_dir $user@$ip:$remote_dir/
expect {
    "password:" {
        send "$pass\r"
        exp_continue
    }
    eof
}

# 3. Restore permissions and ownership
puts "Restoring permissions and ownership on remote server..."
spawn ssh -t $user@$ip "sudo chown -R www-data:www-data $remote_dir && sudo chmod -R 755 $remote_dir"
expect {
    "password for $user:" {
        send "$pass\r"
        exp_continue
    }
    "password:" {
        send "$pass\r"
        exp_continue
    }
    eof
}

puts "Deployment complete."
