#!/usr/bin/expect -f

set timeout -1
set password {&m5L9[eUv}

spawn ssh -o StrictHostKeyChecking=no ubutu@112.78.15.2 "echo '&m5L9\[eUv' | sudo -S find /var/www/crm_phong_kham -type f \\( -name '*.jpg' -o -name '*.png' -o -name '*.jpeg' -o -name '*.pdf' \\) | wc -l"
expect {
    "*assword:*" {
        send "$password\r"
        exp_continue
    }
    eof
}
